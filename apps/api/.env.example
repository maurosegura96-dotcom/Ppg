PORT=3001

# Free key: sign up at https://www.openaip.net (Account -> API Clients).
# Without this, /airspace/near returns HTTP 503 with instructions.
OPENAIP_API_KEY=

# Free key: https://www.maptiler.com/cloud (Account -> Keys). Used server-side
# only for offline PMTiles/terrain-RGB packaging jobs (see docs/PRODUCT_SPEC.md
# section 1.4) -- the web/mobile apps use their own client-side key instead.
MAPTILER_API_KEY=
