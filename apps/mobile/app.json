{
  "expo": {
    "name": "AeroParamotor OS",
    "slug": "aeroparamotor-os",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aeroparamotor.app"
    },
    "android": {
      "package": "com.aeroparamotor.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "ACCESS_BACKGROUND_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AeroParamotor OS usa tu ubicación para el GPS en vivo del Modo Vuelo y el cono de planeo de emergencia."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aec19682-4cf8-463b-b18a-91fd749c6d83"
    },
    "extra": {
      "eas": {
        "projectId": "aec19682-4cf8-463b-b18a-91fd749c6d83"
      }
    }
  }
}
